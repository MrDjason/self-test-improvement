   "source": [
    "# :=\n",
    "variable := expression\n",
    "- 计算 expression 的值。\n",
    "- 将该值赋给 variable。\n",
    "- 同时返回这个值，供外部使用。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "6f2a7f02",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1 2 3 4 5 "
     ]
    }
   ],
   "source": [
    "i = 1\n",
    "while i <= 5:\n",
    "    print(i, end=' ')\n",
    "    i += 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "052b3e55",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1 2 3 4 5 "
     ]
    }
   ],
   "source": [
    "i = 0\n",
    "while (i := i + 1) <= 5:\n",
    "    print(i, end=' ')"
   ]
  }
